# Generate local values with: npm run agents:keys
# Configure private values as encrypted hosting secrets before enabling their features.
AGENT_SIGNING_PRIVATE_KEY=
AGENT_SIGNING_PUBLIC_JWKS=
AGENT_SESSION_SECRET=
MPP_SECRET_KEY=

# No live payment network is supported by this sandbox integration.
AGENT_ENABLE_TEST_PAYMENTS=0
X402_PAY_TO=
MPP_RECIPIENT=
X402_FACILITATOR_URL=https://x402.org/facilitator
